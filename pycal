#!/usr/bin/env python3
"""
2-panel calendar with grid lines + greyed overflow days.
  h/←  l/→  k/↑  j/↓  — navigate days
  [ / ]               — previous / next month
  n / p               — jump to next / prev day with a note
  a / Enter           — edit note for selected day  (Ctrl+G to discard)
  d                   — delete note  (v to undo)
  c                   — copy note for selected day
  v                   — paste copied note
  /                   — search note content
  g                   — go to date
  t                   — jump to today
  r                   — refresh notes from disk
  q / ESC             — close
Notes stored in $XDG_DATA_HOME/cal-notes/YYYY-MM-DD.txt
"""

import bisect, curses, calendar, datetime, json, locale, os, signal, stat, subprocess, sys
from pathlib import Path

_DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")
NOTES = _DATA_HOME / "cal-notes"
NOTE_MAX = 500
_NOTE_BYTES = NOTE_MAX * 4  # 4 bytes/char worst-case UTF-8
_CAL = calendar.Calendar(firstweekday=0)
_DAYS = calendar.day_abbr  # locale-aware, 0=Mon … 6=Sun
_EMPTY = ("", ())  # sentinel for days with no note
_MAX_DATE = datetime.date(9999, 11, 30)  # a Dec 9999 grid would run past date.max

# Control characters have to go: NUL makes addstr raise, tab and CR move the
# cursor, ESC could smuggle terminal sequences in from a hand-edited file.
_CLEAN = {c: None for c in range(32) if c != 10}
_CLEAN[9] = " "
_CLEAN[127] = None

_BS = (curses.KEY_BACKSPACE, 127, 8, "\x7f", "\x08")
_CR = (10, 13, "\n", "\r", curses.KEY_ENTER)

# Key hints, widest first — draw() picks the widest one that fits the terminal.
_HINTS = (
    "  a:edit  d:del  c:copy  v:paste  [:prev-mo  ]:next-mo"
    "  n:next-note  p:prev-note  /:search  g:goto  t:today  r:refresh  q:quit",
    "  a:edit  d:del  c:copy  v:paste  [ ]:month  n/p:note"
    "  /:search  g:goto  t:today  r:reload  q:quit",
    "  a:edit  d:del  c:copy  v:paste  [ ]:mo  n/p:note"
    "  /:find  g:go  t:today  q:quit",
    "  a:edit  d:del  c:copy  v:paste  [ ]  n/p  /  g  t  q:quit",
    "  a:edit  d:del  c:copy  v:paste  [ ] n/p / g t q",
    "  a:edit  d c v  [ ] n/p  / g t r  q:quit",
)

# ── File I/O ──────────────────────────────────────────────────────────────────


def note_path(d):
    return NOTES / f"{d:%Y-%m-%d}.txt"


def decode_note(raw):
    return raw.decode("utf-8", errors="replace").translate(_CLEAN)


def get_note(d):
    try:
        p = note_path(d)
        if not p.is_file():  # opening a fifo here would block forever
            return ""
        with p.open("rb") as f:
            raw = f.read(_NOTE_BYTES + 3)
        return decode_note(raw).strip()[:NOTE_MAX]
    except OSError:
        return ""


def save_note(d, t):
    text = t.strip()
    try:
        p = note_path(d)
        if text:
            NOTES.mkdir(parents=True, exist_ok=True)
            tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
            try:
                tmp.write_text(text + "\n", encoding="utf-8")
                tmp.replace(p)
            except OSError:
                try:
                    tmp.unlink()
                except OSError:
                    pass
                raise
        else:
            try:
                p.unlink()
            except FileNotFoundError:
                pass
    except OSError as e:
        return str(e)


def find_notes(query=None):
    """Sorted list of dates that have a note, optionally filtered by query."""
    q = query.strip().lower() if query and query.strip() else None
    results = []
    try:
        for p in NOTES.glob("????-??-??.txt"):
            try:
                st = p.stat()
                if not stat.S_ISREG(st.st_mode) or st.st_size == 0:
                    continue
                with p.open("rb") as f:
                    content = decode_note(f.read(_NOTE_BYTES + 3))
                if q is not None:
                    if q not in content.lower():
                        continue
                elif not content.strip():
                    continue
                results.append(datetime.date.fromisoformat(p.stem))
            except (OSError, ValueError):
                pass
    except OSError:
        pass
    return sorted(results)


def parse_date(s, ref_y, ref_m):
    """Parse a date string: YYYY-MM-DD, DD/MM/YYYY, DD-MM-YYYY, DD.MM.YYYY, DD/MM, DD.MM, or DD."""
    s = s.strip()
    for fmt in ("%Y-%m-%d", "%d/%m/%Y", "%d-%m-%Y", "%d.%m.%Y", "%Y/%m/%d", "%Y.%m.%d"):
        try:
            d = datetime.datetime.strptime(s, fmt).date()
            if d.year >= 1900:
                return d
        except ValueError:
            pass
    try:
        parts = s.replace(".", "/").split("/")
        if len(parts) == 2:
            return datetime.date(ref_y, int(parts[1]), int(parts[0]))
        if len(parts) == 1 and s.isdigit():
            return datetime.date(ref_y, ref_m, int(s))
    except (ValueError, IndexError):
        pass
    return None


# ── Curses helpers ────────────────────────────────────────────────────────────


def curs(v):
    try:
        curses.curs_set(v)
    except curses.error:
        pass


def safe(scr, row, col, s, attr=0):
    H, W = scr.getmaxyx()
    if row < 0 or row >= H or col < 0 or col >= W:
        return
    try:
        scr.addstr(row, col, s[: W - col], attr)
    except curses.error:
        pass


def prompt_line(scr, row, W, label, maxlen=NOTE_MAX):
    """Single-line input on `row`. Returns str on Enter, None on ESC."""
    safe(scr, row, 0, label.ljust(W - 1), curses.color_pair(1))
    curs(1)
    buf, pos, scroll = [], 0, 0
    x0 = len(label)
    iw = max(1, W - x0 - 2)
    while True:
        # Scroll horizontally so the cursor stays visible in a narrow field
        scroll = max(0, min(scroll, len(buf) - iw + 1))
        if pos < scroll:
            scroll = pos
        elif pos >= scroll + iw:
            scroll = pos - iw + 1
        try:
            scr.move(row, x0)
            scr.clrtoeol()
            scr.addstr(row, x0, "".join(buf)[scroll : scroll + iw], curses.A_BOLD)
            scr.move(row, x0 + pos - scroll)
        except curses.error:
            pass
        scr.refresh()
        try:
            ch = scr.get_wch()
        except KeyboardInterrupt:
            curs(0)
            return None
        if ch in _CR:
            curs(0)
            return "".join(buf)
        elif ch in (27, "\x1b"):
            curs(0)
            return None
        elif ch == curses.KEY_RESIZE:
            curs(0)  # `row` and `x0` are stale now — cancel rather than draw wrong
            return None
        elif ch in _BS:
            if pos:
                buf.pop(pos - 1)
                pos -= 1
        elif ch == curses.KEY_HOME:
            pos = 0
        elif ch == curses.KEY_END:
            pos = len(buf)
        elif ch == curses.KEY_LEFT and pos:
            pos -= 1
        elif ch == curses.KEY_RIGHT and pos < len(buf):
            pos += 1
        elif isinstance(ch, str) and ch.isprintable() and len(buf) < maxlen:
            buf.insert(pos, ch)
            pos += 1


def input_note(scr, start_row, col, w, max_rows, prefill="", hint_row=-1, hint_base=""):
    """Multi-line inline note editor.  Enter = new line,  ESC = save,  Ctrl+G = discard."""
    curs(1)
    buf = list(prefill)
    pos = len(buf)
    scroll_top = 0
    scroll_col = 0
    vw = max(1, w - 1)  # visible columns per line

    def lines():
        return "".join(buf).split("\n")

    def pos_to_rc():
        pre = "".join(buf[:pos]).split("\n")
        return len(pre) - 1, len(pre[-1])

    def rc_to_pos(ri, ci, ls):
        p = sum(len(ls[i]) + 1 for i in range(ri))
        return p + min(ci, len(ls[ri]) if ri < len(ls) else 0)

    while True:
        ls = lines()
        ri, ci = pos_to_rc()

        # Keep cursor inside the visible viewport
        if ri < scroll_top:
            scroll_top = ri
        elif ri >= scroll_top + max_rows:
            scroll_top = ri - max_rows + 1
        if ci < scroll_col:
            scroll_col = ci
        elif ci >= scroll_col + vw:
            scroll_col = ci - vw + 1

        if hint_row >= 0:
            _, W = scr.getmaxyx()
            counter = f"  [{len(buf)}/{NOTE_MAX}]"
            safe(
                scr,
                hint_row,
                0,
                (hint_base + counter).ljust(W - 1),
                curses.color_pair(1),
            )

        for i in range(max_rows):
            row = start_row + i
            li = scroll_top + i
            try:
                scr.move(row, col)
                scr.clrtoeol()
            except curses.error:
                pass
            if li < len(ls):
                try:
                    seg = ls[li][scroll_col : scroll_col + vw]
                    scr.addstr(row, col, seg, curses.A_BOLD)
                except curses.error:
                    pass

        try:
            scr.move(start_row + ri - scroll_top, col + ci - scroll_col)
        except curses.error:
            pass
        scr.refresh()

        try:
            ch = scr.get_wch()
        except KeyboardInterrupt:
            curs(0)
            return prefill
        if ch in (27, "\x1b"):  # ESC → save & exit
            break
        elif ch in (7, "\x07"):  # Ctrl+G → discard
            curs(0)
            return prefill
        elif ch in _CR:  # Enter → newline
            if len(buf) < NOTE_MAX:
                buf.insert(pos, "\n")
                pos += 1
            else:
                curses.beep()
        elif ch in _BS:
            if pos:
                buf.pop(pos - 1)
                pos -= 1
        elif ch == curses.KEY_LEFT and pos:
            pos -= 1
        elif ch == curses.KEY_RIGHT and pos < len(buf):
            pos += 1
        elif ch == curses.KEY_HOME:
            pos = rc_to_pos(ri, 0, ls)
        elif ch == curses.KEY_END:
            pos = rc_to_pos(ri, len(ls[ri]) if ri < len(ls) else 0, ls)
        elif ch == curses.KEY_UP and ri > 0:
            pos = rc_to_pos(ri - 1, ci, ls)
        elif ch == curses.KEY_DOWN and ri < len(ls) - 1:
            pos = rc_to_pos(ri + 1, ci, ls)
        elif ch == curses.KEY_DC:  # forward delete
            if pos < len(buf):
                buf.pop(pos)
        elif ch == curses.KEY_RESIZE:
            break  # geometry came from the caller; save and let main() relayout
        elif isinstance(ch, str) and ch.isprintable() and len(buf) < NOTE_MAX:
            buf.insert(pos, ch)
            pos += 1

    curs(0)
    return "".join(buf)


# ── Drawing ───────────────────────────────────────────────────────────────────


def draw_hline(scr, row, x0, lc, mc, rc, fill, cw):
    s = lc + (fill * cw + mc) * 6 + fill * cw + rc
    safe(scr, row, x0, s, curses.color_pair(5) | curses.A_DIM)


def draw_vbars(scr, row, x0, cw):
    attr = curses.color_pair(5) | curses.A_DIM
    for i in range(8):
        safe(scr, row, x0 + i * (cw + 1), "│", attr)


def draw(scr, cur, today, notes, weeks, status=""):
    H, W = scr.getmaxyx()

    if H < 21 or W < 43:
        scr.erase()
        safe(scr, H // 2, max(0, (W - 20) // 2), "terminal too small", curses.A_DIM)
        scr.refresh()
        return 0, H

    cw = max(5, (W - 8) // 7)
    gw = 7 * (cw + 1) + 1
    x0 = max(0, (W - gw) // 2)
    NOTE_H = max(4, H // 5)
    # The grid has priority: shrink the notes panel (floor 3 rows — date, hints,
    # one line of note) when that is what lets every week keep a row of its own.
    fits_all = H - 7 - 2 * len(weeks)
    if NOTE_H > fits_all:
        NOTE_H = max(3, fits_all)
    m = cur.month

    scr.erase()

    # ── Month header ──────────────────────────────────────────────────────────
    hdr = f"  ◄  {cur.strftime('%B %Y')}  ►  "
    safe(scr, 1, max(0, (W - len(hdr)) // 2), hdr, curses.color_pair(1) | curses.A_BOLD)

    draw_hline(scr, 3, x0, "┌", "┬", "┐", "─", cw)

    # ── Day-of-week header ────────────────────────────────────────────────────
    draw_vbars(scr, 4, x0, cw)
    for i, dn in enumerate(_DAYS):
        x = x0 + 1 + i * (cw + 1) + (cw - len(dn)) // 2
        attr = (
            (curses.color_pair(4) | curses.A_BOLD)
            if i >= 5
            else (curses.color_pair(1) | curses.A_BOLD)
        )
        safe(scr, 4, x, dn, attr)

    draw_hline(scr, 5, x0, "├", "┼", "┤", "─", cw)

    SEP_ROW = H - NOTE_H - 1
    nw = len(weeks)
    avail = SEP_ROW - 6 - nw
    if avail < nw:  # can't give each week 1 row — reduce draw count
        nw = max(1, (SEP_ROW - 6) // 2)
        avail = SEP_ROW - 6 - nw
    row_h = max(1, avail // nw)
    extra = max(0, avail - row_h * nw)  # distribute remainder to last N weeks

    # If a week had to be dropped, slide the window so the selected day is shown
    w0 = 0
    if nw < len(weeks):
        sel = next((i for i, wk in enumerate(weeks) if wk[0] <= cur <= wk[6]), 0)
        w0 = min(max(0, sel - nw + 1), len(weeks) - nw)

    # ── Calendar weeks ────────────────────────────────────────────────────────
    base = 6
    for wi, week in enumerate(weeks[w0:]):
        this_h = row_h + (1 if wi >= nw - extra else 0)
        if base >= SEP_ROW - 1:
            break

        for r in range(this_h):
            if base + r < SEP_ROW:
                draw_vbars(scr, base + r, x0, cw)

        for di, dt in enumerate(week):
            x = x0 + 1 + di * (cw + 1)
            in_month = dt.month == m
            raw, lns = notes.get(dt, _EMPTY)

            if dt == cur:
                attr = curses.color_pair(3) | curses.A_BOLD
            elif dt == today:
                attr = curses.color_pair(2) | curses.A_BOLD
            elif not in_month:
                attr = curses.color_pair(5) | curses.A_DIM
            elif di >= 5:
                attr = curses.color_pair(4)
            else:
                attr = 0

            safe(scr, base, x, f"-{dt.day:2d}-", attr)

            if raw:
                note_attr = (
                    curses.A_DIM if in_month else (curses.color_pair(5) | curses.A_DIM)
                )
                safe(scr, base, x + 4, "·", note_attr)
                for ln_i, ln in enumerate(lns):
                    row = base + 1 + ln_i
                    if row >= base + this_h or row >= SEP_ROW:
                        break
                    display = ln if len(ln) <= cw - 1 else ln[: cw - 2] + "…"
                    safe(scr, row, x, display, note_attr)

        sep = base + this_h
        if sep < SEP_ROW:
            next_base = base + this_h + 1
            if wi == nw - 1 or next_base >= SEP_ROW - 1:
                draw_hline(scr, sep, x0, "└", "┴", "┘", "─", cw)
            else:
                draw_hline(scr, sep, x0, "├", "┼", "┤", "─", cw)

        base += this_h + 1

    # ── Notes panel ───────────────────────────────────────────────────────────
    raw, note_lines = notes.get(cur, _EMPTY)
    ny = SEP_ROW + 1

    safe(scr, SEP_ROW, 0, "─" * (W - 1), curses.color_pair(1))

    safe(
        scr,
        ny,
        0,
        f"  {cur.strftime('%a %d %b %Y')}".ljust(W - 1),
        curses.color_pair(1),
    )
    hints = next((h for h in _HINTS if len(h) <= W - 1), _HINTS[-1])
    safe(scr, ny + 1, 0, hints.ljust(W - 1), curses.color_pair(1))

    if status:
        safe(scr, ny + 2, 2, status[: W - 3], curses.color_pair(6))
    elif note_lines:
        for i, line in enumerate(note_lines):
            row = ny + 2 + i
            if row >= H:
                break
            display = line if len(line) <= W - 3 else line[: W - 4] + "…"
            safe(scr, row, 2, display, curses.A_BOLD)
    else:
        safe(scr, ny + 2, 2, "no note  —  press [a] to add one", curses.A_DIM)

    scr.refresh()
    return ny, H


# ── Main ──────────────────────────────────────────────────────────────────────


def main(scr):
    curs(0)
    try:
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK
    if curses.has_colors():
        BLUE = 69 if curses.COLORS >= 256 else curses.COLOR_BLUE
        PINK = 205 if curses.COLORS >= 256 else curses.COLOR_MAGENTA
        curses.init_pair(1, BLUE, bg)
        curses.init_pair(2, curses.COLOR_YELLOW, bg)
        curses.init_pair(3, curses.COLOR_WHITE, BLUE)
        curses.init_pair(4, PINK, bg)
        curses.init_pair(5, curses.COLOR_WHITE, bg)
        curses.init_pair(6, curses.COLOR_RED, bg)

    cur = datetime.date.today()
    status = ""
    _clipboard = ""

    _cache_key = None
    _cache_notes = {}
    _cache_weeks = []
    _noted_dates = None  # sorted list of all dates with a note; None = stale

    def get_notes(y, m):
        nonlocal _cache_key, _cache_notes, _cache_weeks
        if _cache_key != (y, m):
            _cache_weeks = _CAL.monthdatescalendar(y, m)
            _cache_notes = {}
            for week in _cache_weeks:
                for dt in week:
                    text = get_note(dt)
                    _cache_notes[dt] = (text, text.split("\n") if text else [])
            _cache_key = (y, m)
        return _cache_notes, _cache_weeks

    def get_noted_dates():
        nonlocal _noted_dates
        if _noted_dates is None:
            _noted_dates = find_notes()
        return _noted_dates

    def invalidate():
        nonlocal _cache_key, _noted_dates
        _cache_key = None
        _noted_dates = None

    def update_note(d, text):
        text = text.strip()
        if _cache_key == (d.year, d.month):
            _cache_notes[d] = (text, text.split("\n") if text else [])
        if _noted_dates is not None:
            # Patch the index in place; rescanning costs one read per note file
            i = bisect.bisect_left(_noted_dates, d)
            listed = i < len(_noted_dates) and _noted_dates[i] == d
            if text and not listed:
                _noted_dates.insert(i, d)
            elif not text and listed:
                del _noted_dates[i]

    def move(days=0, months=0):
        nonlocal cur
        try:
            if days:
                cur += datetime.timedelta(days=days)
            if months:
                nm = cur.month + months
                ny2 = cur.year + (nm - 1) // 12
                nm = ((nm - 1) % 12) + 1
                last = calendar.monthrange(ny2, nm)[1]
                cur = cur.replace(year=ny2, month=nm, day=min(cur.day, last))
        except (OverflowError, ValueError):
            pass

    def jump_to_note(forward):
        nonlocal cur, status
        dates = get_noted_dates()
        if not dates:
            status = "no notes found"
            return
        if forward:
            nexts = [d for d in dates if d > cur]
            cur = nexts[0] if nexts else dates[0]
            if not nexts:
                status = "wrapped to first note"
        else:
            prevs = [d for d in dates if d < cur]
            cur = prevs[-1] if prevs else dates[-1]
            if not prevs:
                status = "wrapped to last note"

    while True:
        today = datetime.date.today()
        cur = min(cur, _MAX_DATE)  # catches goto, note files and month stepping
        notes, weeks = get_notes(cur.year, cur.month)
        ny, H = draw(scr, cur, today, notes, weeks, status)
        status = ""
        _, W = scr.getmaxyx()
        ch = scr.getch()

        if ch in (ord("q"), ord("Q"), 27):
            try:
                mons = json.loads(
                    subprocess.run(
                        ["hyprctl", "-j", "monitors"],
                        capture_output=True,
                        text=True,
                        timeout=2,
                    ).stdout
                )
                if any(
                    m.get("specialWorkspace", {}).get("name") == "special:term"
                    for m in mons
                ):
                    subprocess.run(
                        [
                            "hyprctl",
                            "eval",
                            'hl.dispatch(hl.dsp.focus({ window = "class:scratchpad-term" }))',
                        ],
                        capture_output=True,
                        timeout=2,
                    )
            except Exception:
                pass
            break
        elif ch == curses.KEY_RESIZE:
            pass
        elif ch in (curses.KEY_LEFT, ord("h")):
            move(-1)
        elif ch in (curses.KEY_RIGHT, ord("l")):
            move(+1)
        elif ch in (curses.KEY_UP, ord("k")):
            move(-7)
        elif ch in (curses.KEY_DOWN, ord("j")):
            move(+7)
        elif ch == ord("["):
            move(months=-1)
        elif ch == ord("]"):
            move(months=+1)
        elif ch in (ord("t"), ord("T")):
            cur = today
        elif ch in (ord("r"), ord("R")):
            invalidate()
            status = "reloaded from disk"
        elif ch in (ord("n"), ord("N")):
            jump_to_note(forward=True)
        elif ch in (ord("p"), ord("P")):
            jump_to_note(forward=False)
        elif ch == ord("/") and ny > 0:
            query = prompt_line(scr, ny, W, "  search: ")
            if query and query.strip():
                results = find_notes(query)
                if results:
                    nexts = [d for d in results if d > cur]
                    cur = nexts[0] if nexts else results[0]
                    n = len(results)
                    wrap = "  (wrapped)" if not nexts else ""
                    status = f"{n} match{'es' if n != 1 else ''} for '{query}'{wrap}"
                else:
                    status = f"no matches for '{query}'"
        elif ch in (ord("g"), ord("G")) and ny > 0:
            label = "  go to (DD  DD/MM  YYYY-MM-DD): " if W >= 60 else "  go to: "
            ds = prompt_line(scr, ny, W, label)
            if ds and ds.strip():
                parsed = parse_date(ds, cur.year, cur.month)
                if parsed:
                    cur = parsed
                else:
                    status = f"invalid date: '{ds}'"
        elif ch in (ord("d"), ord("D")) and ny > 0:
            raw, _ = notes.get(cur, _EMPTY)
            if raw:
                _clipboard = raw
                err = save_note(cur, "")
                if err:
                    status = f"delete failed: {err}"
                else:
                    update_note(cur, "")
                    status = "deleted  (v to undo — overwrites clipboard)"
            else:
                status = "no note to delete"
        elif ch in (ord("c"), ord("C")) and ny > 0:
            raw, _ = notes.get(cur, _EMPTY)
            if raw:
                _clipboard = raw
                status = "copied"
            else:
                status = "no note to copy"
        elif ch in (ord("v"), ord("V")) and ny > 0:
            if _clipboard:
                had_note = bool(notes.get(cur, _EMPTY)[0])
                err = save_note(cur, _clipboard)
                if err:
                    status = f"paste failed: {err}"
                else:
                    update_note(cur, _clipboard)
                    status = (
                        "pasted (overwrote existing note)" if had_note else "pasted"
                    )
            else:
                status = "clipboard empty"
        elif ch in (ord("a"), ord("A"), 10, 13, curses.KEY_ENTER) and ny > 0:
            max_rows = max(1, H - ny - 2)
            hint_base = (
                f"  {cur.strftime('%a %d %b %Y')}"
                f"   Enter:new-line   ESC:save   Ctrl+G:discard"
            )
            safe(scr, ny, 0, hint_base.ljust(W - 1), curses.color_pair(1))
            safe(scr, ny + 1, 0, " " * (W - 1), curses.color_pair(1))
            prefill, _ = notes.get(cur, _EMPTY)
            new = input_note(
                scr,
                ny + 2,
                2,
                W - 3,
                max_rows,
                prefill,
                hint_row=ny,
                hint_base=hint_base,
            )
            if new.strip() != prefill:
                err = save_note(cur, new)
                if err:
                    status = f"save failed: {err}"
                else:
                    update_note(cur, new)


def _sigterm(sig, frame):
    try:
        curses.endwin()
    except Exception:
        pass
    sys.exit(0)


signal.signal(signal.SIGTERM, _sigterm)
os.environ.setdefault("ESCDELAY", "75")
try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error:
    pass
try:
    curses.wrapper(main)
except KeyboardInterrupt:
    pass
